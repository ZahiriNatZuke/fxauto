<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FxAuto</RootNamespace>
    <AssemblyName>FxAuto</AssemblyName>
    <!-- Product version: the release workflow checks the git tag (vX.Y.Z) against it. -->
    <Version>1.0.0</Version>
    <!-- Tray program: workstation GC without a background thread to use less memory when idle. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- Generated from Ui/Settings/AppIcon.cs by tools/make-icon (same drawing as the tray and the windows). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FxAuto.Core\FxAuto.Core.csproj" />
  </ItemGroup>
</Project>
