<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool (not shipped, not in FxAuto.sln): writes src/FxAuto/app.ico from the shared drawing in
       src/FxAuto/Ui/Settings/AppIcon.cs, so the tray, the windows and the .exe show the same icon.
       Usage: dotnet run with project tools/make-icon, arguments [outFile] [preview switch, see Program.cs] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>FxAuto.MakeIcon</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\FxAuto\Ui\Settings\AppIcon.cs" Link="Linked\AppIcon.cs" />
  </ItemGroup>
</Project>
