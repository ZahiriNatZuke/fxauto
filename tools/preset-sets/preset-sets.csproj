<Project Sdk="Microsoft.NET.Sdk">
  <!-- One-off tool (not shipped, not in FxAuto.sln): builds the per-device preset sets decided on 2026-10-26
       (Realtek - X from every G435 - X, Live Stream presets from G435 - Video) with the real controller, preset
       operations, port and preset file store, then updates config.json through ConfigJson + ConfigValidator.
       Never kills, closes or relaunches FxSound. Without apply it only prints the plan.
       Usage: preset-sets <logFile> [apply] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FxAuto.PresetSets</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FxAuto.Core\FxAuto.Core.csproj" />
    <Compile Include="..\..\src\FxAuto\Native.cs" Link="Linked\Native.cs" />
    <Compile Include="..\..\src\FxAuto\FxSound\FacFile.cs" Link="Linked\FacFile.cs" />
    <Compile Include="..\..\src\FxAuto\FxSound\PresetFileStore.cs" Link="Linked\PresetFileStore.cs" />
    <Compile Include="..\..\src\FxAuto\FxSound\FxSoundPort.cs" Link="Linked\FxSoundPort.cs" />
  </ItemGroup>
</Project>
